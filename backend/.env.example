# BookLeaf Environment Configuration Template
# Copy this file to .env and provide your actual credentials.

# Google Gemini LLM API Configuration
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# JWT Authentication
SECRET_KEY=replace_with_a_long_random_secret_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL
# PostgreSQL (Supabase / Render / Railway):
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS Allowed Origins (Comma-separated for production)
# Example: http://localhost:5173,https://your-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
